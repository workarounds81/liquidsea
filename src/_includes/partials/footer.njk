<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="footer__word">LIQUIDSEA</p>
      <p class="footer__desc">{{ site.description }}</p>
    </div>
    <nav class="footer__nav" aria-label="Footer">
      <a href="{{ '/digest/' | url }}">Digest archive</a>
      <a href="{{ '/events/' | url }}">Events calendar</a>
      <a href="{{ '/events/archive/' | url }}">Events archive</a>
      <a href="{{ '/sponsor/' | url }}">Sponsor</a>
      <a href="{{ '/about/' | url }}">About</a>
      <a href="{{ '/opportunities/' | url }}">Opportunities</a>
      <a href="{{ '/digest/feed.xml' | url }}">RSS / Atom feed</a>
    </nav>
    <div class="footer__contact">
      <p class="footer__k">CONTACT</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p class="footer__fine">© {{ build.year }} {{ site.name }} · Curated by humans, built in the open.</p>
    </div>
  </div>
</footer>
<script src="{{ '/assets/js/filters.js' | url }}?v={{ 'src/assets/js/filters.js' | assetHash }}" defer></script>
