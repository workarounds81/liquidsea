{% set latestPost = collections.digest | first %}
{% set latestIssueData = deals[latestPost.data.issue] if latestPost else null %}
{% set latestDeals = (latestIssueData.deals or []) if latestIssueData else [] %}
{% set nextEvent = events | upcomingEvents(build.now) | first %}
<header class="masthead">
  <div class="masthead__inner container">
    <a class="masthead__logo" href="{{ '/' | url }}" aria-label="{{ site.name }} — home">
      <svg class="masthead__mark" aria-hidden="true" focusable="false" viewBox="0 0 32 32" width="34" height="34"><rect width="32" height="32" fill="#0C1F23"/><rect x="1" y="3" width="30" height="2.5" fill="#EFF5F0"/><rect x="5" y="5.5" width="5" height="13" fill="#0E7C66"/><rect x="13.5" y="5.5" width="5" height="21" fill="#FFB320"/><rect x="22" y="5.5" width="5" height="9" fill="#FF4B33"/></svg>
      <span class="masthead__wordmark">LIQUID<span class="masthead__wordmark-alt">SEA</span></span>
    </a>
    <nav class="masthead__nav" aria-label="Primary">
      <a href="{{ '/digest/' | url }}">Digest</a>
      <a href="{{ '/events/' | url }}">Events</a>
      <a href="{{ '/sponsor/' | url }}">Sponsor</a>
      <a href="{{ '/about/' | url }}">About</a>
      <a href="{{ '/opportunities/' | url }}">Opportunities</a>
    </nav>
  </div>
  {% if latestPost %}
  {% set tickerEvents = events | upcomingEvents(build.now) %}
  <div class="ticker" aria-label="Market ticker">
    <p class="visually-hidden">Issue {{ latestPost.data.issue | weekLabel }}: {{ latestDeals | length }} deals, {{ latestDeals | totalUsd | usd }} disclosed. Next event: {{ nextEvent.event_name if nextEvent else "none scheduled" }}.</p>
    <div class="ticker__track" aria-hidden="true">
      {% for copy in range(0, 2) %}
      <div class="ticker__group">
        <span class="ticker__item"><span class="ticker__k">ISSUE</span> {{ latestPost.data.issue | weekLabel }}</span>
        <span class="ticker__item"><span class="ticker__k">DEALS</span> {{ latestDeals | length }}</span>
        <span class="ticker__item"><span class="ticker__k">DISCLOSED</span> {{ latestDeals | totalUsd | usd }}</span>
        {% for deal in latestDeals %}
        <span class="ticker__item">{{ deal.project_name | upper }} <span class="ticker__up">▲</span> {{ deal.amount_usd | usd }} · {{ deal.country_or_region | cc }} · {{ deal.round_type | upper }}</span>
        {% endfor %}
        {% for event in tickerEvents %}{% if loop.index <= 6 %}
        <span class="ticker__item"><span class="ticker__k">{{ event.country | cc }}</span> {{ event.event_name | upper }} · {{ event.start_date | dateRange(event.end_date) | upper }}</span>
        {% endif %}{% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</header>
